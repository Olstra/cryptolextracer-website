	file = {Full Text PDF:/Users/cryptoaction/Zotero/storage/JJ2PFWZ6/Longa - 2025 - Cryptocurrency and Money Laundering.pdf:application/pdf},
}

@article{sitompul_cryptocurrency_2025,
