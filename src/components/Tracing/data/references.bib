@article{oladipupo_cryptocurrency_2025,
	title = {Cryptocurrency, {Terrorism} {Financing}, and the {Dark} {Web}: {An} {Exploratory} {Study} of the {Role} of {Anonymous} {Transactions} in {Supporting} {Terrorist} {Activities}},
	volume = {17},
	issn = {2141-1565},
	shorttitle = {Cryptocurrency, {Terrorism} {Financing}, and the {Dark} {Web}},
	url = {https://journals.abuad.edu.ng/ajsd/article/view/2052},
	doi = {10.53982/ajsd.2025.1702.09-j},
	abstract = {The expansion of cryptocurrency has reshaped financial systems by enabling decentralised transactions and new digital applications. However, its pseudonymity and global reach have also enabled ransomware, darknet trading, money laundering, and terrorism financing, creating challenges for regulators seeking to protect financial integrity. This study examines the intersection of cryptocurrency, cybercrime, and governance. It identifies techniques exploited by criminals, evaluates forensic and regulatory countermeasures, and considers the governance dilemmas posed by these developments. A qualitative, desk-based approach was adopted, drawing on peer-reviewed literature, institutional policy reports (FATF, IMF, Europol), and industry analyses (Chainalysis, Elliptic, TRM Labs). Thematic content analysis was used to trace patterns of illicit cryptocurrency use, enforcement actions, and regulatory innovations. The findings reveal that blockchain forensics and coordinated policy efforts have strengthened oversight. Yet criminals increasingly use privacy coins, decentralised finance protocols, mixers, and cross-chain laundering to bypass detection. Enforcement remains inconsistent, hindered by fragmented regulation and gaps in cross-border cooperation. Cryptocurrency-enabled crime and terrorism financing remain adaptive threats that test financial stability and governance frameworks. Stronger international coordination, harmonised regulation, and advanced forensic tools are essential to reduce risks. The study recommends deepening cross-border collaboration, investing in blockchain analytics, and adopting flexible governance models that balance innovation with accountability.},
	language = {en},
	number = {2},
	urldate = {2026-09-15},
	journal = {African Journal of Stability and Development (AJSD)},
	author = {Oladipupo, AbdulMalik Olalekan},
	month = nov,
	year = {2025},
	keywords = {(chap) background, Blockchain Forensics, Cryptocurrency Regulation, Dark Web Transactions, Global Financial Governance, Terrorism Financing},
	pages = {971--988},
	file = {Full Text PDF:/Users/cryptoaction/Zotero/storage/39CY8HSB/Oladipupo - 2025 - Cryptocurrency, Terrorism Financing, and the Dark Web An Exploratory Study of the Role of Anonymous.pdf:application/pdf},
}

@article{kim_survey_2026,
	title = {A {Survey} on {Crypto}-{Asset} {Mixers} and {Countermeasures}},
	volume = {14},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/abstract/document/11431591},
	doi = {10.1109/ACCESS.2026.3673258},
	abstract = {Since the introduction of Bitcoin, many malicious parties have used crypto-assets to launder money. To counteract such activities, law enforcement disrupted money laundering attempts by leveraging the traceable nature of the blockchain that comprises crypto-assets. However, those attempts have evolved by incorporating mixing techniques (i.e., mixers or tumblers) that were originally introduced to enhance the privacy of blockchain transactions. While government officials are prohibiting and sanctioning some mixing services for mitigation, the role and implications of these techniques remain a topic of ongoing debate. Regarding the context of this debate, we survey existing mixing techniques, including research works and services, and categorize them employing concrete characteristics that distinguish different types of mixers. Furthermore, we examine the legal and technical measures put in place to mitigate the use of mixing techniques for money laundering. Based on the review, we identify deficiencies in existing mixing techniques and their countermeasures, as well as potential solutions and future research directions.},
	urldate = {2026-09-15},
	journal = {IEEE Access},
	author = {Kim, Beomjoong and Heo, Seungmin and Lee, Nakjun and Cho, Hyunwoo and Choi, Hojin and Jeon, Kiseok and Choi, Jione and Lee, Junghee},
	year = {2026},
	keywords = {Bitcoin, Blockchains, Blockchain, Security, Law enforcement, Privacy, (chap) background, crypto-asset, Government, mixer, Mixers, money laundering, privacy, Reviews, Surveys, Terminology},
	pages = {40190--40214},
	file = {Full Text PDF:/Users/cryptoaction/Zotero/storage/MSBFTA6R/Kim et al. - 2026 - A Survey on Crypto-Asset Mixers and Countermeasures.pdf:application/pdf},
}

